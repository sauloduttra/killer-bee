# Os clones do upstream vivem FORA da raiz do projeto, em D:\EMPRESAS\buzz\_upstream\.
# Esta entrada existe como rede de segurança: se alguém reclonar aqui dentro por engano,
# não vai versionar — e, mais importante, o .claude/skills/ e o CLAUDE.md do upstream
# não devem ser carregados na sessão de quem trabalha neste projeto.
.upstream/
_upstream/

node_modules/
.next/
out/
dist/
target/

__pycache__/
.pytest_cache/
.ruff_cache/
.venv/

# Artefatos gerados a partir de packs/ — o repositório é a fonte da verdade, e
# versionar a saída criaria duas verdades que divergem em silêncio.
# O diretório inteiro, e não arquivo por arquivo: a lista por nome deixou de
# cobrir o segundo gerado no dia em que ele apareceu (D-037).
site/data/
site/public/downloads/

.env
.env.*
!.env.example
*.nsec
*.key

.DS_Store
Thumbs.db

# Producao de video (artefatos pesados; scripts ficam em site/scripts/)
/media/
