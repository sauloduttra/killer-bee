{
  "name": "waggle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "//data": "Gera o catálogo e os snapshots baixáveis a partir de packs/. O --out do build aponta para public/downloads porque é exatamente a URL que as páginas linkam.",
    "data": "node scripts/prepare-data.mjs",
    "dev": "npm run data && next dev",
