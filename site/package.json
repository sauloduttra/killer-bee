    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run build && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "typescript": "7.0.2"
  }
}
